# Copy to scripts/deploy.env (git-ignored) and fill in.
# This file lives on your LAPTOP, not on the server.

# An ssh target. Use a Host alias from ~/.ssh/config so the key, port and
# user live there rather than here.
DEPLOY_HOST=quanta-server

# Where the repository is checked out on the server.
DEPLOY_PATH=/opt/quanta

# Branch to deploy. Defaults to the branch you are on.
# DEPLOY_BRANCH=claude/biochart-k9zlu1

# Checked from inside the server after the stack restarts.
# HEALTH_URL=http://127.0.0.1:8000/api/v1/health/ready

# Never set this to 1 in a file. If you must skip the suite, do it once on
# the command line: SKIP_TESTS=1 ./scripts/deploy.sh
# SKIP_TESTS=0
