# Copy to .env for local development.
ENVIRONMENT=development
DEBUG=true

# Generate each of these SEPARATELY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# SECRET_KEY signs sessions. VAULT_MASTER_KEY unwraps the exchange API
# keys that can place orders. They are two secrets because one leak
# should not cost both; production refuses to start if the second is
# missing or equal to the first.
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-any-real-deployment
VAULT_MASTER_KEY=

# Must match infra/.env — compose has no default password for either.
DATABASE_URL=postgresql+asyncpg://quanta:CHANGE_ME@localhost:5432/quanta
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies must be Secure in production; over plain http://localhost they are not sent.
COOKIE_SECURE=false

# --- Market data ---
# The real venue. Point these at the local simulator
# (python -m quanta.exchanges.sim) when it is unreachable — a restricted
# region per SPEC §9, or a network policy that blocks it:
#   EXCHANGE_REST_URL=http://127.0.0.1:8100
#   EXCHANGE_WS_URL=ws://127.0.0.1:8100/public/
EXCHANGE_REST_URL=https://fapi.bitunix.com
EXCHANGE_WS_URL=wss://fapi.bitunix.com/public/

MARKET_WARM_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_WARM_INTERVALS=1m,15m,1h
MARKET_WARM_BARS=1500

# --- Tunnels (Resources -> Network) ---
# Each imported WireGuard config runs as a wireproxy process. The production
# image includes it; on a laptop, install it (go install
# github.com/windtf/wireproxy/cmd/wireproxy@v1.1.3) or leave tunnels off —
# the page says they cannot run and alerts go from this machine.
# WIREPROXY_COMMAND=wireproxy
# WIREPROXY_AWG_COMMAND=
# TUNNEL_PROBE_URL=https://www.cloudflare.com/cdn-cgi/trace
