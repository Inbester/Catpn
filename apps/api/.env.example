# Copy to .env for local development.
ENVIRONMENT=development
DEBUG=true

# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-any-real-deployment

DATABASE_URL=postgresql+asyncpg://quanta:quanta_dev_password@localhost:5432/quanta
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies must be Secure in production; over plain http://localhost they are not sent.
COOKIE_SECURE=false

# --- Market data ---
# The real venue. Point these at the local simulator
# (python -m quanta.exchanges.sim) when it is unreachable — a restricted
# region per SPEC §9, or a network policy that blocks it:
#   EXCHANGE_REST_URL=http://127.0.0.1:8100
#   EXCHANGE_WS_URL=ws://127.0.0.1:8100/public/
EXCHANGE_REST_URL=https://fapi.bitunix.com
EXCHANGE_WS_URL=wss://fapi.bitunix.com/public/

MARKET_WARM_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_WARM_INTERVALS=1m,15m,1h
MARKET_WARM_BARS=1500
