# Copy to infra/.env before `docker compose up`. Compose refuses to start
# without the two passwords, on purpose: a default that works everywhere
# is a password that works everywhere.
#
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Where the services listen ------------------------------------------
# 127.0.0.1 means only this machine can reach them. Change it only if the
# API runs on a different host, and put them on a private network if you
# do — neither of these should ever be reachable from the internet.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

POSTGRES_USER=quanta
POSTGRES_DB=quanta
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- The server (docker-compose.prod.yml only) ----------------------------
# Unused by the local database-only compose file. See docs/DEPLOY.md, Part 2.

# Two different secrets. Production refuses to start if VAULT_MASTER_KEY is
# missing, short, or equal to SECRET_KEY: one leak must not cost both.
SECRET_KEY=
VAULT_MASTER_KEY=

# The address the site is served on, and the same with its scheme.
SITE_ADDRESS=quanta.internal
SITE_ORIGIN=https://quanta.internal
# The server's VPN address, or 127.0.0.1 if you reach it through a tunnel.
BIND_ADDRESS=127.0.0.1

# The address orders leave from, whitelisted on the exchange key. Without
# it no exchange key can be added at all.
EXCHANGE_STATIC_IP=

# From @BotFather. Without it Telegram alerts fail, and say why.
TELEGRAM_BOT_TOKEN=

# Optional: an AmneziaWG build of wireproxy, for AmneziaWG tunnel configs.
WIREPROXY_AWG_COMMAND=

# Your age public key (run age-keygen on the laptop). scripts/backup.sh needs it.
BACKUP_RECIPIENT=
