# Copy to infra/.env before `docker compose up`. Compose refuses to start
# without the two passwords, on purpose: a default that works everywhere
# is a password that works everywhere.
#
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Where the services listen ------------------------------------------
# 127.0.0.1 means only this machine can reach them. Change it only if the
# API runs on a different host, and put them on a private network if you
# do — neither of these should ever be reachable from the internet.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

POSTGRES_USER=quanta
POSTGRES_DB=quanta
POSTGRES_PORT=5432
REDIS_PORT=6379
