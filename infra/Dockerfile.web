# The web image: a Vite build served by Caddy.
#
# Built from the repository root:
#   docker build -f infra/Dockerfile.web -t quanta-web .

# --- Build ---------------------------------------------------------------
FROM node:22-slim AS build

WORKDIR /build
# The lockfile first, so a dependency change is the only thing that
# invalidates the install layer.
COPY apps/web/package.json apps/web/package-lock.json ./
# `npm ci` installs exactly the lockfile and fails if package.json has
# drifted from it — which is what you want on a deploy.
RUN npm ci

COPY apps/web ./
RUN npm run build

# --- Runtime -------------------------------------------------------------
FROM caddy:2.8-alpine AS runtime

COPY --from=build /build/dist /srv
COPY infra/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
